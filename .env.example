# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000

# Database Configuration (PostgreSQL / Supabase)
# Set this to your Supabase connection string for production
DATABASE_URL=postgresql://postgres:password@localhost:5432/shewwina

# JWT Authentication Secret — REQUIRED
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
# NEVER commit a real secret here. Set it in your deployment environment.
JWT_SECRET=

# Supabase (Phase 7 — required for production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the frontend
SUPABASE_SERVICE_ROLE_KEY=

# Grok AI Integration (Phase 9 — backend only, never expose to frontend)
AI_PROVIDER=mock
AI_ENABLED=true
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# FreePBX / VoIP (optional voice notification channel)
FREEPBX_HOST=
FREEPBX_USERNAME=
FREEPBX_PASSWORD=

# External Messaging Configuration (Phase 8 — SMS & WhatsApp)
# Defaults to 'mock' (zero-cost console logging for development and testing)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SHEWIN
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
