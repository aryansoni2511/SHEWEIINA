# ==============================================================================
# SHEWWINA — Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
# In production, set this to your exact frontend origin (e.g., https://shewwina.vercel.app)
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000

# Database Configuration (PostgreSQL / Supabase) — REQUIRED IN PRODUCTION
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Note: In development/test mode, an unconfigured DATABASE_URL falls back to in-memory store for offline unit tests.
# In production (NODE_ENV=production), a valid live PostgreSQL/Supabase DATABASE_URL is strictly required.
DATABASE_URL=postgresql://postgres:password@localhost:5432/shewwina

# JWT Authentication Secret — REQUIRED IN ALL ENVIRONMENTS
# Generate a secure 64-byte random string with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER commit a real secret to source control.
JWT_SECRET=

# Supabase (Optional — for direct Supabase client / Auth integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the frontend
SUPABASE_SERVICE_ROLE_KEY=

# Grok AI Integration (Phase 9 — backend wait-time prediction)
# Defaults to 'mock' provider for zero-cost offline heuristic estimation
AI_PROVIDER=mock
AI_ENABLED=true
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1

# External Messaging Configuration (Phase 8 — SMS & WhatsApp)
# Defaults to 'mock' (zero-cost console logging for development and testing)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SHEWIN
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
